# ==========================================
# CONFIGURAZIONE PROVIDER LLM E MODELLI
# ==========================================
# Opzioni supportate: "ollama" oppure "huggingface"
LLM_PROVIDER=ollama

# Modelli da utilizzare
LLM_MODEL=qwen2.5
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# Parametri di inferenza
LLM_TEMPERATURE=0.0
ENABLE_VERBOSE_CALLBACKS=true

# Directory per i dati e i modelli
HTML_RAW_DIR=data/raw/html_samples
PDF_LINKS_FILE=data/raw/html_samples/pdf_links.txt